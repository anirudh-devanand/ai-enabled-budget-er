# Woney environment template — copy to backend/.env or set in your host.
# Never commit real secrets.
#
# Primary prefix: WONEY_*
# Legacy: LEDGER_* is still accepted as a fallback until you rename vars on Render/Fly.

WONEY_ENV=development
WONEY_DEBUG=false
WONEY_DATABASE_URL=postgresql+asyncpg://woney:woney@localhost:5432/woney

# Required in production (WONEY_ENV=production)
WONEY_JWT_SECRET=replace-with-long-random-string
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WONEY_DATA_ENCRYPTION_KEY=replace-with-fernet-key
WONEY_OPS_TOKEN=replace-with-cron-shared-secret
# Include current + legacy Vercel hosts (code also merges known cutover hosts):
WONEY_CORS_ORIGINS=http://localhost:3000,https://woneyai.vercel.app,https://woney-web-blue.vercel.app,https://ledger-web-blue.vercel.app
# Public web origin for password-reset email links (optional; derived from OAuth redirect if unset):
# WONEY_PUBLIC_APP_URL=https://woneyai.vercel.app

# Optional
# WONEY_FLINKS_BASE_URL=https://toolbox-api.private.fin.ag
# WONEY_FLINKS_CUSTOMER_ID=
# WONEY_FLINKS_AUTH_KEY=
# WONEY_LLM_API_KEY=

# Email (Resend) — account deletion OTPs + password-reset links when both are set.
# Aliases: LEDGER_RESEND_API_KEY / LEDGER_EMAIL_FROM still work if WONEY_* unset.
# Without these: deletion falls back to TOTP/inline; password reset logs the link
# in non-production only (never returns tokens in production).
# WONEY_RESEND_API_KEY=
# WONEY_EMAIL_FROM=Woney <noreply@yourdomain.com>

# Plaid (primary bank link — sandbox keys from dashboard.plaid.com)
# Set these on the Render API service (NOT only on Vercel). LEDGER_PLAID_* still aliases.
# WONEY_PLAID_CLIENT_ID=
# WONEY_PLAID_SECRET=
# WONEY_PLAID_ENV=sandbox
# WONEY_PLAID_COUNTRY_CODES=CA
# WONEY_PLAID_PRODUCTS=transactions
# WONEY_PLAID_DAYS_OF_TRANSACTIONS=365
# After setting vars: Manual Deploy → verify GET /healthz → "plaid_configured": true

# SSO — Google works when both client id/secret are set; Apple/Microsoft when fully set.
# WONEY_GOOGLE_OAUTH_CLIENT_ID=
# WONEY_GOOGLE_OAUTH_CLIENT_SECRET=
# Default fallback when request Origin is missing; live auth uses the browser Origin
# when it is in the CORS allow-list (so woneyai.vercel.app works without redeploying secrets).
# Also add the same callback URL in Google Cloud Console → Authorized redirect URIs.
# WONEY_OAUTH_REDIRECT_URI=https://woneyai.vercel.app/login/oauth/callback
#
# Apple Sign In (Services ID + .p8 key from developer.apple.com):
# WONEY_APPLE_OAUTH_CLIENT_ID=          # Services ID (e.g. com.example.woney.web)
# WONEY_APPLE_OAUTH_TEAM_ID=            # 10-char Team ID
# WONEY_APPLE_OAUTH_KEY_ID=             # Key ID for the Sign In with Apple key
# WONEY_APPLE_OAUTH_PRIVATE_KEY=        # PEM contents; use \n for newlines in env
#
# Microsoft (Azure AD app registration — web redirect URI must match WONEY_OAUTH_REDIRECT_URI):
# WONEY_MICROSOFT_OAUTH_CLIENT_ID=
# WONEY_MICROSOFT_OAUTH_CLIENT_SECRET=

# Web (apps/web)
# NEXT_PUBLIC_API_URL=https://woney-api-ayer.onrender.com
# NEXT_PUBLIC_FLINKS_IFRAME_URL=   # legacy only; connect page now uses Plaid + CSV

# Mobile (apps/mobile)
# EXPO_PUBLIC_API_URL=https://woney-api-ayer.onrender.com
# EXPO_PUBLIC_WEB_URL=https://woney-web-blue.vercel.app
