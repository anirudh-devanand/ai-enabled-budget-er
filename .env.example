# Ledger environment template — copy to backend/.env or set in your host.
# Never commit real secrets.

LEDGER_ENV=development
LEDGER_DEBUG=false
LEDGER_DATABASE_URL=postgresql+asyncpg://ledger:ledger@localhost:5432/ledger

# Required in production (LEDGER_ENV=production)
LEDGER_JWT_SECRET=replace-with-long-random-string
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LEDGER_DATA_ENCRYPTION_KEY=replace-with-fernet-key
LEDGER_OPS_TOKEN=replace-with-cron-shared-secret
LEDGER_CORS_ORIGINS=http://localhost:3000,https://your-web.vercel.app

# Optional
# LEDGER_FLINKS_BASE_URL=https://toolbox-api.private.fin.ag
# LEDGER_FLINKS_CUSTOMER_ID=
# LEDGER_FLINKS_AUTH_KEY=
# LEDGER_LLM_API_KEY=

# Web (apps/web)
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXT_PUBLIC_FLINKS_IFRAME_URL=

# Mobile (apps/mobile)
# EXPO_PUBLIC_API_URL=https://api.example.com
