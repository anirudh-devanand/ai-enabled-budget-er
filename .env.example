# Ledger environment template — copy to backend/.env or set in your host.
# Never commit real secrets.

LEDGER_ENV=development
LEDGER_DEBUG=false
LEDGER_DATABASE_URL=postgresql+asyncpg://ledger:ledger@localhost:5432/ledger

# Required in production (LEDGER_ENV=production)
LEDGER_JWT_SECRET=replace-with-long-random-string
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LEDGER_DATA_ENCRYPTION_KEY=replace-with-fernet-key
LEDGER_OPS_TOKEN=replace-with-cron-shared-secret
LEDGER_CORS_ORIGINS=http://localhost:3000,https://your-web.vercel.app

# Optional
# LEDGER_FLINKS_BASE_URL=https://toolbox-api.private.fin.ag
# LEDGER_FLINKS_CUSTOMER_ID=
# LEDGER_FLINKS_AUTH_KEY=
# LEDGER_LLM_API_KEY=

# Email (Resend) — account deletion OTPs are emailed when both are set.
# Without these: MFA users confirm with TOTP; others get a one-time inline code.
# LEDGER_RESEND_API_KEY=
# LEDGER_EMAIL_FROM=Woney <noreply@yourdomain.com>

# Plaid (primary bank link — sandbox keys from dashboard.plaid.com)
# Exact names required on Render (prefix LEDGER_ matches pydantic Settings):
# LEDGER_PLAID_CLIENT_ID=
# LEDGER_PLAID_SECRET=
# LEDGER_PLAID_ENV=sandbox
# LEDGER_PLAID_COUNTRY_CODES=CA
# LEDGER_PLAID_PRODUCTS=transactions
# LEDGER_PLAID_DAYS_OF_TRANSACTIONS=365
# After setting vars: Manual Deploy → verify GET /healthz → "plaid_configured": true

# SSO — Google works when both client id/secret are set; Apple/Microsoft when fully set.
# LEDGER_GOOGLE_OAUTH_CLIENT_ID=
# LEDGER_GOOGLE_OAUTH_CLIENT_SECRET=
# LEDGER_OAUTH_REDIRECT_URI=https://ledger-web-blue.vercel.app/login/oauth/callback
#
# Apple Sign In (Services ID + .p8 key from developer.apple.com):
# LEDGER_APPLE_OAUTH_CLIENT_ID=          # Services ID (e.g. com.example.woney.web)
# LEDGER_APPLE_OAUTH_TEAM_ID=            # 10-char Team ID
# LEDGER_APPLE_OAUTH_KEY_ID=             # Key ID for the Sign In with Apple key
# LEDGER_APPLE_OAUTH_PRIVATE_KEY=        # PEM contents; use \n for newlines in env
#
# Microsoft (Azure AD app registration — web redirect URI must match LEDGER_OAUTH_REDIRECT_URI):
# LEDGER_MICROSOFT_OAUTH_CLIENT_ID=
# LEDGER_MICROSOFT_OAUTH_CLIENT_SECRET=

# Web (apps/web)
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXT_PUBLIC_FLINKS_IFRAME_URL=   # legacy only; connect page now uses Plaid + CSV

# Mobile (apps/mobile)
# EXPO_PUBLIC_API_URL=https://api.example.com
